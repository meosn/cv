<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Mariia Solovei - CV</title>
  <style>
    @page {
      size: A4;
      margin: 0;
    }

    :root {
      --ink: #050505;
      --blue: #173f5d;
      --paper: #ffffff;
      --page-w: 210mm;
      --page-h: 297mm;
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      min-height: 100%;
      background: #f3f3f3;
      color: var(--ink);
      font-family: Georgia, "Times New Roman", serif;
    }

    body {
      display: flex;
      justify-content: center;
      padding: 16px;
    }

    .page {
      width: var(--page-w);
      min-height: var(--page-h);
      background: var(--paper);
      display: grid;
      grid-template-columns: 60mm 1fr;
      column-gap: 21mm;
      padding: 10mm 12mm 10mm 12mm;
      box-shadow: 0 2px 18px rgba(0, 0, 0, 0.14);
    }

    .sidebar {
      background: var(--blue);
      color: #fff;
      min-height: calc(var(--page-h) - 20mm);
      padding: 18mm 7.3mm 10mm;
    }

    .name {
      margin: 0 0 26mm;
      font-size: 21pt;
      line-height: 1.42;
      letter-spacing: 0.06em;
      font-weight: 700;
      text-transform: uppercase;
      text-align: center;
    }

    .side-section {
      margin: 0 0 8mm;
    }

    .side-section h2 {
      margin: 0 0 7mm;
      font-size: 12.4pt;
      line-height: 1.1;
      letter-spacing: 0.045em;
      font-weight: 700;
      text-transform: uppercase;
    }

    .side-section p,
    .side-section li {
      margin: 0;
      font-size: 10.7pt;
      line-height: 1.18;
    }

    .side-section .spaced {
      margin-top: 9mm;
    }

    .side-section .note {
      margin-top: 1.5mm;
      font-size: 8.8pt;
      line-height: 1.08;
    }

    .side-list {
      list-style: none;
      padding: 0;
      margin: 6mm 0 0;
    }

    .side-list li {
      margin-bottom: 4.2mm;
    }

    .content {
      padding-top: 12mm;
    }

    .cv-title {
      margin: 0 0 12mm;
      color: var(--blue);
      font-size: 28pt;
      line-height: 1;
      letter-spacing: 0.07em;
      font-weight: 400;
      text-transform: uppercase;
    }

    .section {
      margin: 0 0 9mm;
    }

    .section h2 {
      margin: 0 0 7mm;
      color: var(--blue);
      font-size: 14.8pt;
      line-height: 1;
      letter-spacing: 0.075em;
      font-weight: 400;
      text-transform: uppercase;
    }

    .entry {
      position: relative;
      margin: 0 0 5.4mm;
      padding-left: 5.2mm;
    }

    .entry::before {
      content: "-";
      position: absolute;
      left: 0;
      top: 0;
      font-size: 12.5pt;
      line-height: 1.16;
    }

    .entry p {
      margin: 0;
      font-size: 11.4pt;
      line-height: 1.17;
    }

    .entry .lead {
      font-size: 12.8pt;
      line-height: 1.16;
    }

    .entry .indent {
      margin-top: 2.2mm;
      padding-left: 4.3mm;
      font-size: 12.1pt;
    }

    a {
      color: var(--blue);
      text-decoration: none;
    }

    .compact {
      margin-bottom: 3.8mm;
    }

    .awards .entry {
      margin-bottom: 5.6mm;
    }

    @media print {
      html,
      body {
        width: var(--page-w);
        height: var(--page-h);
        background: #fff;
        padding: 0;
      }

      body {
        display: block;
      }

      .page {
        width: var(--page-w);
        height: var(--page-h);
        min-height: 0;
        box-shadow: none;
        overflow: hidden;
        break-after: avoid;
        page-break-after: avoid;
      }
    }

    @media screen and (max-width: 820px) {
      body {
        padding: 0;
        background: var(--paper);
      }

      .page {
        width: 100%;
        min-height: auto;
        grid-template-columns: 1fr;
        gap: 0;
        padding: 0;
        box-shadow: none;
      }

      .sidebar {
        min-height: auto;
        padding: 32px 28px;
      }

      .name {
        margin-bottom: 28px;
      }

      .content {
        padding: 30px 28px 42px;
      }
    }
  </style>
</head>
<body>
  <main class="page" aria-label="Lebenslauf Mariia Solovei">
    <aside class="sidebar">
